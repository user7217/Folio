{
  "name": "self-hosted-reading-platform",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "verify": "node scripts/verify.js",
    "lint": "node scripts/lint.js",
    "format:check": "node scripts/format-check.js",
    "typecheck": "node scripts/typecheck.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "build": "node scripts/build.js",
    "smoke": "node scripts/smoke.js",
    "benchmark": "node benchmark/run.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "migrate": "node scripts/migrate.js",
    "dev": "node apps/web/src/server.js",
    "start": "NODE_ENV=production node apps/web/src/server.js",
    "worker": "node apps/worker/src/worker.js"
  }
}
